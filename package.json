{
	"name": "@creative-int/packet-plugins",
	"version": "0.1.0",
	"private": true,
	"description": "Packet agent plugin companion: generated Cursor, Codex, Claude Code, MCP, and packet-context skill adapters.",
	"keywords": [
		"packet",
		"agent-skills",
		"mcp",
		"context",
		"receipts",
		"artifacts"
	],
	"homepage": "https://packet.creative-int.com",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/creative-int/packet-plugins.git"
	},
	"type": "module",
	"files": [
		".claude-plugin",
		".codex-plugin",
		".cursor-plugin",
		".mcp.json",
		"server.json",
		"LICENSE",
		"README.md",
		"skills"
	],
	"scripts": {
		"generate": "node tooling/generate.ts",
		"check:generated": "node tooling/generate.ts --check",
		"typecheck": "tsc --noEmit",
		"smoke": "node tooling/smoke.ts",
		"verify": "pnpm run check:generated && pnpm run typecheck && pnpm run smoke"
	},
	"creativeInt": {
		"repoProfile": "agent-plugin-companion",
		"companionOf": "packet"
	},
	"devDependencies": {
		"@types/node": "^22.15.0",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@10.28.2",
	"engines": {
		"node": ">=22 <23",
		"pnpm": ">=10.28.2"
	}
}
