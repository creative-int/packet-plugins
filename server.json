{
	"$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
	"name": "io.github.creative-int/packet",
	"description": "Read shared Packet artifacts, sources, evidence, and receipt graphs from agents.",
	"version": "0.1.0",
	"repository": {
		"url": "https://github.com/creative-int/packet-plugins",
		"source": "github"
	},
	"remotes": [
		{
			"type": "streamable-http",
			"url": "https://packet.creative-int.com/api/mcp"
		}
	],
	"metadata": {
		"repoProfile": "agent-plugin-companion",
		"companionOf": "packet",
		"tools": [
			{
				"name": "packet_search",
				"scope": "packet.read",
				"readOnly": true,
				"endpoint": "https://packet.creative-int.com/api/mcp/search"
			},
			{
				"name": "packet_get",
				"scope": "packet.read",
				"readOnly": true,
				"endpoint": "https://packet.creative-int.com/api/mcp/get"
			}
		]
	}
}
